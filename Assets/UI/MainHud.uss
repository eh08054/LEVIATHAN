/* Main screen HUD, option B (2026-11-27), drawn to match Tools/Art/proto/ui_mock.html?v=b (its CSS values × 1.2,
   since the mock-up was 1600 wide and the panel is 1920). Layout: Assets/Resources/UI/MainHud.uxml, data:
   OpsMainHud.cs. USS has no gradients or box shadows: the emblem's orb is a texture (Resources/UiKit2/orb.png),
   the rest are flat translucent fills. Motion by USS transitions. The root gets .ops--hud2 so the old top bar,
   side menu and overview panels step aside. */

.mh { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(234, 243, 255); -unity-font-definition: url("/Assets/Fonts/Pretendard/Pretendard-Regular SDF.asset"); }
.mh .num { -unity-font-definition: url("/Assets/Fonts/Rajdhani/Rajdhani-Bold SDF.asset"); }
/* Unity's default label spacing off; kept weaker than the single-class rules below so their margins win */
.mh-l { margin: 0; padding: 0; }

.mh-shade { position: absolute; left: 0; right: 0; }
.mh-shade--top { top: 0; height: 216px; background-image: url("/Assets/Resources/UiKit/shade_top.png"); -unity-background-scale-mode: stretch-to-fill; }
.mh-shade--bottom { bottom: 0; height: 264px; background-image: url("/Assets/Resources/UiKit/shade_bottom.png"); -unity-background-scale-mode: stretch-to-fill; }

/* ---------- emblem and delegation stage ---------- */
.mh-emblem { position: absolute; left: 26px; top: 22px; width: 115px; height: 115px; transition-property: scale; transition-duration: 0.2s; }
.mh-emblem:hover { scale: 1.05 1.05; }
.mh-emblem-ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mh-emblem-orb { position: absolute; left: 17px; top: 17px; right: 17px; bottom: 17px; background-image: url("/Assets/Resources/UiKit2/orb.png"); -unity-background-scale-mode: scale-to-fit; }
.mh-stage { position: absolute; left: 151px; top: 36px; }
.mh-stage-kicker { font-size: 16px; color: rgb(143, 180, 216); letter-spacing: 2px; }
.mh-stage-value { font-size: 31px; -unity-font-style: bold; }
.mh-cells { flex-direction: row; margin-top: 5px; }
.mh-cell { width: 31px; height: 8px; border-radius: 4px; margin-right: 5px; background-color: rgba(140, 180, 220, 0.25); }
.mh-cell--on { background-color: rgb(53, 201, 232); }
.mh-cell--part { background-color: rgba(53, 201, 232, 0.5); }

/* ---------- clock ---------- */
.mh-clock { position: absolute; left: 50%; top: 19px; translate: -50% 0; align-items: center; }
.mh-date { font-size: 36px; letter-spacing: 1px; }
.mh-speeds { flex-direction: row; margin-top: 5px; }
.mh-round { width: 46px; height: 46px; border-radius: 23px; margin: 0 4px; padding: 0; border-width: 2px; border-color: rgba(120, 200, 240, 0.35); background-color: rgba(10, 24, 44, 0.75); color: rgb(191, 230, 255); font-size: 17px; -unity-font-style: bold; transition-property: scale, background-color, border-color; transition-duration: 0.15s; }
.mh-round:hover { scale: 1.08 1.08; border-color: rgb(120, 220, 255); }
.mh-round:active { scale: 0.94 0.94; }
.mh-round--on { background-color: rgb(47, 134, 255); border-color: rgb(156, 199, 255); color: rgb(255, 255, 255); }
.mh-broadcast { margin-top: 14px; font-size: 18px; color: rgb(159, 238, 255); letter-spacing: 1px; }

/* ---------- crisis forecast ---------- */
.mh-crisis { position: absolute; left: 50%; top: 170px; translate: -50% 0; flex-direction: row; align-items: center; padding: 10px 26px 10px 10px; border-radius: 40px; border-width: 1px; border-color: rgb(242, 160, 61); background-color: rgba(110, 55, 12, 0.82); transition-property: scale; transition-duration: 0.2s; }
.mh-crisis:hover { scale: 1.03 1.03; }
.mh-crisis-dd { width: 65px; height: 65px; border-radius: 33px; background-color: rgb(242, 160, 61); color: rgb(42, 20, 0); font-size: 24px; -unity-text-align: middle-center; }
.mh-crisis-text { margin-left: 14px; }
.mh-crisis-title { font-size: 22px; -unity-font-style: bold; }
.mh-crisis-sub { font-size: 16px; color: rgb(255, 217, 168); }

/* ---------- resources and menu ---------- */
.mh-res { position: absolute; right: 29px; top: 26px; flex-direction: row; align-items: center; }
.mh-chip { flex-direction: row; align-items: center; margin-left: 17px; padding: 7px 17px 7px 7px; border-radius: 31px; border-width: 1px; border-color: rgba(120, 200, 240, 0.3); background-color: rgba(8, 20, 40, 0.7); }
.mh-chip-icon { width: 43px; height: 43px; border-radius: 22px; padding: 8px; }
.mh-chip-icon--energy { background-color: rgb(74, 53, 16); }
.mh-chip-icon--info { background-color: rgb(16, 52, 72); }
.mh-chip-icon--pop { background-color: rgb(22, 50, 74); }
.mh-chip-value { margin-left: 10px; font-size: 29px; }
.mh-menu { margin-left: 14px; font-size: 22px; }

/* ---------- index gauges ---------- */
.mh-gauges { position: absolute; left: 31px; top: 180px; }
.mh-gauge { flex-direction: row; align-items: center; margin-bottom: 19px; transition-property: translate; transition-duration: 0.15s; }
.mh-gauge:hover { translate: 4px 0; }
.mh-gauge-dial { width: 94px; height: 94px; }
.mh-gauge-in { position: absolute; left: 12px; top: 12px; right: 12px; bottom: 12px; border-radius: 35px; background-color: rgba(6, 16, 32, 0.8); align-items: center; justify-content: center; }
.mh-gauge-icon { width: 31px; height: 31px; }
.mh-gauge-text { margin-left: 12px; }
.mh-gauge-value { font-size: 36px; }
.mh-gauge-name { font-size: 16px; color: rgb(159, 192, 224); margin-top: -2px; }
.mh-gauge--warn .mh-gauge-value { color: rgb(255, 207, 143); }
.mh-gauge--bad .mh-gauge-value { color: rgb(255, 160, 160); }

/* ---------- feed: a few cards, a picture and one line ---------- */
.mh-feed { position: absolute; right: 26px; top: 132px; width: 396px; }
.mh-card { flex-direction: row; align-items: center; margin-bottom: 14px; padding: 12px 17px 12px 12px; border-radius: 19px; border-width: 1px; border-color: rgba(120, 200, 240, 0.25); background-color: rgba(8, 20, 40, 0.78); opacity: 0; translate: 40px 0; transition-property: opacity, translate, scale; transition-duration: 0.35s; transition-timing-function: ease-out-back; }
.mh-card--in { opacity: 1; translate: 0 0; }
.mh-card:hover { scale: 1.02 1.02; }
.mh-card-pic { width: 70px; height: 70px; flex-shrink: 0; border-radius: 35px; border-width: 2px; border-color: rgb(53, 201, 232); background-color: rgb(15, 42, 68); align-items: center; justify-content: center; -unity-background-scale-mode: scale-and-crop; overflow: hidden; }
.mh-card-text { margin-left: 14px; flex-shrink: 1; }
.mh-card-title { font-size: 20px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mh-card-sub { font-size: 17px; color: rgb(169, 198, 228); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mh-card--bad { border-color: rgba(238, 90, 90, 0.7); }
.mh-card--bad .mh-card-pic { border-color: rgb(238, 90, 90); background-color: rgb(58, 18, 24); }

/* ---------- round minimap ---------- */
.mh-mini { position: absolute; left: 29px; bottom: 26px; width: 204px; height: 204px; border-radius: 102px; border-width: 3px; border-color: rgba(120, 200, 240, 0.5); background-color: rgb(6, 16, 32); overflow: hidden; -unity-background-scale-mode: scale-and-crop; }

/* ---------- command dock (replaces the side menu) ---------- */
.mh-dock { position: absolute; left: 50%; bottom: 22px; translate: -50% 0; flex-direction: row; align-items: flex-end; }
.mh-cmd { width: 116px; margin: 0 4px; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); align-items: center; transition-property: translate; transition-duration: 0.15s; }
.mh-cmd:hover { translate: 0 -5px; }
.mh-cmd-hex { width: 89px; height: 89px; border-radius: 26px; rotate: 45deg; border-width: 2px; border-color: rgba(120, 200, 240, 0.45); background-color: rgb(18, 44, 76); transition-property: scale, background-color; transition-duration: 0.12s; }
.mh-cmd:active .mh-cmd-hex { scale: 0.92 0.92; }
.mh-cmd--on .mh-cmd-hex { background-color: rgb(47, 116, 220); border-color: rgb(188, 216, 255); }
.mh-cmd-icon { position: absolute; left: 25px; top: 25px; width: 38px; height: 38px; rotate: -45deg; }
.mh-cmd-label { margin-top: 24px; font-size: 18px; -unity-font-style: bold; }
.mh-cmd-badge { position: absolute; right: -8px; top: -8px; rotate: -45deg; min-width: 29px; height: 29px; border-radius: 15px; background-color: rgb(238, 90, 90); font-size: 17px; -unity-text-align: middle-center; padding: 0 6px; }

/* ---------- corner: map layers, view switch ---------- */
.mh-corner { position: absolute; right: 29px; bottom: 31px; align-items: flex-end; }
.mh-seg { flex-direction: row; padding: 5px; margin-top: 12px; border-radius: 31px; border-width: 1px; border-color: rgba(120, 200, 240, 0.3); background-color: rgba(8, 20, 40, 0.8); }
.mh-seg-item { padding: 10px 19px; margin: 0; border-width: 0; border-radius: 24px; background-color: rgba(0, 0, 0, 0); color: rgb(159, 192, 224); font-size: 18px; transition-property: background-color, color; transition-duration: 0.15s; }
.mh-seg-item:hover { color: rgb(234, 243, 255); }
.mh-seg-item--on { background-color: rgb(47, 134, 255); color: rgb(255, 255, 255); }

.mh-sysmenu { position: absolute; right: 29px; top: 96px; display: none; padding: 8px; border-radius: 16px; border-width: 1px; border-color: rgba(120, 200, 240, 0.35); background-color: rgba(8, 20, 40, 0.94); }
.mh-sysmenu--open { display: flex; }
.mh-sysmenu Button { margin: 2px 0; padding: 10px 22px; font-size: 18px; border-width: 0; border-radius: 10px; background-color: rgba(0, 0, 0, 0); color: rgb(220, 236, 250); -unity-text-align: middle-left; }
.mh-sysmenu Button:hover { background-color: rgba(76, 141, 255, 0.25); }

/* ---------- model view: the city on a monitor, a cyan line, index bars on both sides ---------- */
.mh-bezel { position: absolute; left: 132px; right: 132px; top: 150px; bottom: 182px; border-width: 2px; border-color: rgba(53, 201, 232, 0.8); border-radius: 31px; opacity: 0; scale: 1.1 1.1; transition-property: opacity, scale; transition-duration: 0.55s; transition-timing-function: ease-out-cubic; }
.mh--model .mh-bezel { opacity: 1; scale: 1 1; }
.mh-power { position: absolute; left: 4%; right: 4%; top: 50%; height: 4px; background-color: rgb(200, 250, 255); opacity: 0; scale: 0.2 1; transition-property: opacity, scale; transition-duration: 0.25s; }
.mh-power--line { opacity: 1; scale: 1 1; }
.mh-power--open { opacity: 0; scale: 1 60; transition-duration: 0.35s; }

.mh-side { position: absolute; top: 150px; bottom: 182px; width: 132px; justify-content: space-around; align-items: center; opacity: 0; transition-property: opacity, translate; transition-duration: 0.45s; }
.mh-side--left { left: 0; translate: -40px 0; }
.mh-side--right { right: 0; translate: 40px 0; }
.mh--model .mh-side { opacity: 1; translate: 0 0; }
.mh-bar-item { align-items: center; }
.mh-bar { width: 36px; height: 144px; border-radius: 18px; border-width: 1px; border-color: rgba(53, 201, 232, 0.4); background-color: rgba(140, 180, 220, 0.15); overflow: hidden; }
.mh-bar-fill { position: absolute; left: 0; right: 0; bottom: 0; border-radius: 17px; background-color: rgb(95, 216, 242); }
.mh-bar-fill--warn { background-color: rgb(242, 168, 70); }
.mh-bar-value { margin-top: 6px; font-size: 26px; -unity-text-align: middle-center; }
.mh-bar-name { font-size: 16px; color: rgb(159, 192, 224); -unity-text-align: middle-center; }

/* in the model view the side bars replace the gauges; the cards, banner and map controls stay out of the monitor */
.mh--model .mh-gauges, .mh--model .mh-feed, .mh--model .mh-crisis, .mh--model .mh-mini, .mh--model .mh-seg--layers { display: none; }

/* a page is open: the side gauges, cards, banner, minimap and map controls make room */
.mh--page .mh-gauges, .mh--page .mh-feed, .mh--page .mh-crisis, .mh--page .mh-corner, .mh--page .mh-mini, .mh--page .mh-side, .mh--page .mh-bezel { display: none; }

/* the game's old frame steps aside */
.ops--hud2 .topbar, .ops--hud2 .sidebar, .ops--hud2 .ov-col, .ops--hud2 .city-caption, .ops--hud2 .map-layers, .ops--hud2 .map-mode, .ops--hud2 .map-legend, .ops--hud2 .guide { display: none; }
.ops--hud2 .page-host { left: 26px; right: 26px; top: 160px; bottom: 160px; }
