/* Model view HUD (option C, trial 2026-11-27): the AI's view over the 3D city model. Colours follow Ops.uss. */
.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-font-definition: url("/Assets/Fonts/Pretendard/Pretendard-Regular SDF.asset"); color: #E6EEFC; font-size: 14px; }
.num { -unity-font-definition: url("/Assets/Fonts/Rajdhani/Rajdhani-SemiBold SDF.asset"); }
.bracket { position: absolute; padding: 12px 14px; background-color: rgba(8, 18, 36, 0.55); border-width: 0; }
.corner { position: absolute; width: 14px; height: 14px; border-color: rgba(53, 201, 232, 0.85); }
.corner.tl { left: 0; top: 0; border-left-width: 2px; border-top-width: 2px; }
.corner.tr { right: 0; top: 0; border-right-width: 2px; border-top-width: 2px; }
.corner.bl { left: 0; bottom: 0; border-left-width: 2px; border-bottom-width: 2px; }
.corner.br { right: 0; bottom: 0; border-right-width: 2px; border-bottom-width: 2px; }
.h3 { font-size: 11px; letter-spacing: 2px; color: #35C9E8; margin-bottom: 8px; -unity-font-style: bold; }

.top { position: absolute; left: 0; top: 0; right: 0; height: 44px; flex-direction: row; align-items: center; padding: 0 20px; background-color: rgba(6, 14, 30, 0.82); border-bottom-width: 1px; border-color: rgba(53, 201, 232, 0.35); }
.top .title { color: #35C9E8; letter-spacing: 3px; -unity-font-style: bold; margin-right: 18px; }
.top .grow { flex-grow: 1; }
.top .clock { font-size: 18px; margin: 0 14px; }
.tabs { flex-direction: row; background-color: rgba(5, 12, 26, 0.8); border-width: 1px; border-color: rgba(53, 201, 232, 0.3); border-radius: 6px; padding: 2px; margin-left: 12px; }
.tab { background-color: rgba(0, 0, 0, 0); border-width: 0; color: #9FB3D1; font-size: 13px; padding: 4px 12px; margin: 0; border-radius: 4px; }
.tab:hover { color: #E6EEFC; }
.tab.on { background-color: #4C8DFF; color: #FFFFFF; }
.cells { flex-direction: row; margin-left: 8px; }
.cell { width: 12px; height: 10px; border-width: 1px; border-color: #35C9E8; margin-left: 3px; }
.cell.f { background-color: #35C9E8; }
.dim { color: #9FB3D1; font-size: 12px; }

.ix { margin-bottom: 9px; }
.ix-row { flex-direction: row; justify-content: space-between; align-items: flex-end; }
.ix-name { font-size: 12px; color: #C4D2E8; }
.ix-val { font-size: 20px; }
.ix-d { font-size: 12px; margin-left: 6px; margin-bottom: 2px; }
.bar { height: 3px; background-color: rgba(159, 179, 209, 0.2); margin-top: 2px; }
.bar-fill { height: 3px; background-color: #35C9E8; }

.al { flex-direction: row; padding: 6px 4px; border-top-width: 1px; border-color: rgba(53, 201, 232, 0.15); }
.al:hover { background-color: rgba(76, 141, 255, 0.15); }
.al-dot { width: 7px; height: 7px; border-radius: 4px; margin: 5px 8px 0 0; }
.al-title { font-size: 12px; }
.al-sub { font-size: 11px; color: #9FB3D1; white-space: normal; }

.card-row { flex-direction: row; justify-content: space-between; font-size: 13px; margin: 2px 0; }
.btn { margin: 8px 0 0 0; padding: 7px; border-width: 0; border-radius: 6px; background-color: #4C8DFF; color: #FFFFFF; font-size: 13px; }
.btn.soft { background-color: #192B46; border-width: 1px; border-color: #35C9E8; }

.dock { flex-direction: row; align-items: center; padding: 8px 14px; }
.dock .grp { flex-direction: row; align-items: center; margin-right: 14px; }
.dock .lbl { color: #9FB3D1; font-size: 12px; margin-right: 4px; }

.tag { position: absolute; width: 96px; height: 36px; background-color: rgba(5, 14, 28, 0.82); border-left-width: 2px; padding: 3px 0 0 8px; }
.tag-name { font-size: 12px; -unity-font-style: bold; }
.tag-pop { font-size: 12px; color: #9FB3D1; }
.tag-bar { position: absolute; right: 8px; bottom: 8px; width: 32px; height: 3px; background-color: rgba(159, 179, 209, 0.25); }
.tag-bar-fill { height: 3px; }

.sky-label { position: absolute; font-size: 11px; color: rgba(196, 210, 232, 0.85); -unity-text-align: middle-right; width: 80px; }
.sky-val { position: absolute; font-size: 16px; }
.sky-tick { position: absolute; font-size: 10px; color: rgba(159, 179, 209, 0.7); width: 40px; -unity-text-align: middle-center; }
.sky-head { position: absolute; left: 0; right: 0; -unity-text-align: middle-center; }
.toast { position: absolute; width: 380px; -unity-text-align: middle-center; white-space: normal; }
.help { position: absolute; left: 16px; bottom: 14px; font-size: 11px; color: #7F93B3; }
